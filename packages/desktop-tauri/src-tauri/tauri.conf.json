{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paseo",
  "version": "0.9.2",
  "identifier": "sh.paseo.desktop.tauri",
  "build": {
    "frontendDist": "../../../packages/app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "resources": [
      "../server-dist/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "installerHooks": "hooks/nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["paseo"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMjM1OApSV1RUUUVKVE40...=",
      "endpoints": [
        "https://github.com/getpaseo/paseo/releases/latest/download/latest.json"
      ]
    }
  }
}